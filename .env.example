# Vonage application (Dashboard > Applications > your app)
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=./private.key
# Vonage API key/secret (Dashboard > top of page) — used only for account-level calls, not voice JWT auth
VONAGE_API_KEY=
VONAGE_API_SECRET=

# The Vonage number linked to the application above, E.164 without the leading +
VONAGE_NUMBER=

# Public HTTPS URL this server is reachable at (must match the app's Answer/Event URLs)
SERVER_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Local server
PORT=3000
DATABASE_PATH=./ringback.db

# Demo-only: destination numbers for the M0 test call and the seeded directory
M0_TEST_DESTINATION=
DEMO_MANAGER_PHONE=
DEMO_WORKER_PHONE=

# Set to "true" to require press-1 before the recording notice continues (all-party consent states)
ALL_PARTY_CONSENT_STATE=false
